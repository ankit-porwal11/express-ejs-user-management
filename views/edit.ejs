<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>
 <h1>Edit User</h1>

<form action="/update-user" method="POST">
 // yha aake data username alreadty fill ho rha hai  
   <input
      type="text"
      name="username"
      value="<%= username %>"
   >

   <br><br>
   // same email me bhi data already fill ho rha hai 
   <input
      type="text"
      name="email"
      value="<%= email %>"
   >

   <!-- hidden old data -->
   <input
      type="hidden"
      name="oldData"
      value="<%= oldData %>"
   >

   <br><br>

   <button>
      Update Submit
   </button>

</form>
    
</body>
</html>