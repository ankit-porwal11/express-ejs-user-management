     <h1>All Users</h1>

<form action="/delete" method="POST">

    <% users.forEach((item) => { %>

        <input 
            type="checkbox" 
            name="selectUsers" 
            value="<%= item %>"
        >

        <pre><%= item %></pre>

        <hr>

    <% }) %>

    <button type="submit">
        Delete Selected
    </button>
     </form>
